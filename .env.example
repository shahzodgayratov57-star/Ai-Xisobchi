# Telegram bot tokeni (@BotFather dan olinadi)
TELEGRAM_BOT_TOKEN=

# Faqat shu Telegram foydalanuvchisi botdan foydalana oladi (bo'sh qoldirsangiz - hammaga ochiq)
ALLOWED_TELEGRAM_USER_ID=

# Shu guruh ID'sida esa guruhning barcha a'zolari botdan foydalana oladi (ixtiyoriy)
ALLOWED_GROUP_CHAT_ID=

# OpenAI API kaliti (kategoriyalashtirish, ovozni matnga o'girish va hujjat tahlili uchun)
OPENAI_API_KEY=

# Google Sheets sozlamalari
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
# Railway kabi hosting'da fayl o'rniga JSON matnini shu yerga qo'yish mumkin
# (credentials.json faylining butun mazmuni, bitta qatorda)
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Tranzaksiyalar

# Ixtiyoriy: AI modellari
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
